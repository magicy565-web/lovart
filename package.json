{
  "name": "lovart",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:status": "node scripts/migrate.mjs --status",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:architecture": "node scripts/check-architecture.mjs",
    "test:contracts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-feature-contracts.mjs",
    "test:foundation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/test-campaign-foundation.mjs",
    "test:concept": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/test-concept-validation.mjs",
    "test:commercialization": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-alias-loader.mjs scripts/test-campaign-commercialization.mjs",
    "test:migrations": "node scripts/test-migrations.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test:contracts && pnpm test:foundation && pnpm test:concept && pnpm test:commercialization && pnpm test:migrations && pnpm test:architecture"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.9",
    "@assistant-ui/react": "^0.14.26",
    "@assistant-ui/react-ai-sdk": "^1.3.40",
    "@assistant-ui/react-markdown": "^0.14.5",
    "@base-ui/react": "^1.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "1.6.1",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.26",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.16.0",
    "motion": "^12.42.2",
    "next": "16.2.6",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.2",
    "react": "^19",
    "react-dom": "^19",
    "react-resizable-panels": "^3.0.6",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.8.0",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.11",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.6",
    "playwright-core": "1.55.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3"
  }
}
