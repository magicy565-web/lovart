{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "output.schema.json",
  "title": "DesignReinforcementArtifactV1",
  "type": "object",
  "required": ["version", "stage", "artifact_id", "product_id", "created_at", "visual_features", "pattern_library", "visual_dna", "design_directions", "evidence_trace"],
  "properties": {
    "version": { "const": 1 },
    "stage": { "const": "directions_ready" },
    "artifact_id": { "type": "string", "pattern": "^dra_" },
    "product_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "visual_features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["feature", "value", "confidence", "supporting_evidence_ids", "interpretation"],
        "properties": {
          "feature": { "type": "string" },
          "value": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "supporting_evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^ev_" } },
          "interpretation": { "type": "string" }
        }
      }
    },
    "pattern_library": { "type": "array", "minItems": 3, "items": { "$ref": "visual-pattern.schema.json" } },
    "visual_dna": {
      "type": "object",
      "required": ["brand_personality", "composition_rules", "typography_rules", "color_strategy", "imagery_rules", "motion_rules", "forbidden_patterns"],
      "properties": {
        "brand_personality": { "type": "array", "items": { "type": "string" } },
        "composition_rules": { "type": "array", "items": { "type": "string" } },
        "typography_rules": { "type": "array", "items": { "type": "string" } },
        "color_strategy": { "type": "array", "items": { "type": "string" } },
        "imagery_rules": { "type": "array", "items": { "type": "string" } },
        "motion_rules": { "type": "array", "items": { "type": "string" } },
        "forbidden_patterns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "design_directions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "design-direction.schema.json" }
    },
    "evidence_trace": {
      "type": "object",
      "required": ["evidence_ids", "assumptions", "unresolved_gaps"],
      "properties": {
        "evidence_ids": { "type": "array", "minItems": 3, "items": { "type": "string", "pattern": "^ev_" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "unresolved_gaps": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
